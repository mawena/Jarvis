<?xml version="1.0" encoding="utf-8"?>
<!-- Rien ne sort du téléphone, ni par la sauvegarde en ligne ni par le transfert vers
     un nouvel appareil : jeton d'appairage, phrase hors ligne et mot d'éveil restent ici. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
